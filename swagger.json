{
  "openapi": "3.0.0",
  "info": {
    "title": "Financial Support Assistant API",
    "version": "1.0.0",
    "description": "Financial Assistant API with JWT Authentication"
  },
  "servers": [
    {
      "url": "https://financial-assistant-api.onrender.com",
      "description": "Production Server"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "User Login to generate JWT Token",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "admin@financial.com" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful, returns JWT token" },
          "400": { "description": "Validation error" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Send chat query to Financial Assistant (Protected)",
        "tags": ["Chat"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sessionId", "message"],
                "properties": {
                  "sessionId": { "type": "string", "example": "render-test-session" },
                  "message": { "type": "string", "example": "Hi, who are you?" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Success" },
          "401": { "description": "Unauthorized / Missing Token" },
          "403": { "description": "Forbidden / Invalid Token" }
        }
      }
    }
  }
}